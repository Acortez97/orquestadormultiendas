# Fotos de articulos: uploads/<token-aleatorio-de-la-tienda>/<archivo-aleatorio>
# Solo se sirven imagenes; nada se ejecuta y no se listan carpetas.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(php|phtml|phar|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
