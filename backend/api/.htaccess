# MultiTienda API — enruta todo a index.php
RewriteEngine On

# Si la API NO esta en /api, ajusta esta linea (ej: RewriteBase /)
RewriteBase /api/

# Pasar el header Authorization (algunos hostings de GoDaddy lo quitan)
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Archivos reales se sirven tal cual; el resto va al front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
