# Orquestador MultiTiendas API — enruta todo a index.php
RewriteEngine On

# Nunca listar directorios (p. ej. uploads/<carpeta-de-tienda>/)
Options -Indexes

# Archivos que no se deben descargar nunca (esquema, credenciales locales, notas, logs)
<FilesMatch "\.(sql|txt|md|log|bak|example\.php)$">
  Require all denied
</FilesMatch>

# Si la API NO esta en /api, ajusta esta linea (ej: RewriteBase /)
RewriteBase /api/

# Pasar el header Authorization (algunos hostings de GoDaddy lo quitan)
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Archivos reales se sirven tal cual; el resto va al front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
