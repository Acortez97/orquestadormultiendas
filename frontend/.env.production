# Orquestador MultiTiendas — Frontend (PRODUCCION / GoDaddy)
# El backend PHP vive en el MISMO dominio bajo /api, por eso la URL es RELATIVA
# (asi el front sirve en cualquier dominio sin recompilar). Se incluye "index.php"
# para que funcione aunque el hosting no tenga mod_rewrite activo.
# Vite usa este archivo automaticamente en "npm run build".
VITE_API_URL=/api/index.php/v1
VITE_SOCKET_URL=
