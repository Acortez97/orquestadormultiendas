# LEVOTEK — Frontend
# En desarrollo el backend PHP corre aparte (ej. http://localhost/sistematienda/backend/public)
# En produccion (GoDaddy, mismo dominio) usa rutas relativas: /api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Socket.io no se usa en el despliegue PHP/GoDaddy. Dejar vacio para desactivar tiempo real.
VITE_SOCKET_URL=
